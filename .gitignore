# Build output
/build/
*.o
*.d

# The container rootfs is generated by bundles/busybox/fetch-rootfs.sh and is
# not tracked (binary, large). Keep the directory via .gitkeep but ignore its
# populated contents.
bundles/*/rootfs/*
!bundles/*/rootfs/.gitkeep

# Runtime state (in case someone points RT_STATE_DIR at the tree)
/run/
*.tmp

# Editor / OS noise
*.swp
.DS_Store
compile_commands.json
.cache/
