{
  "ociVersion": "1.0.2",
  "hostname": "container",
  "root": {
    "path": "rootfs",
    "readonly": false
  },
  "process": {
    "terminal": false,
    "cwd": "/",
    "args": [
      "/bin/sh",
      "-c",
      "echo \"hello from pid $$ inside $(hostname)\"; echo \"proc list:\"; ls /proc | head -5; echo done"
    ],
    "env": [
      "PATH=/bin:/usr/bin:/sbin:/usr/sbin",
      "HOME=/root",
      "TERM=xterm"
    ],
    "user": {
      "uid": 0,
      "gid": 0
    }
  },
  "linux": {
    "namespaces": [
      { "type": "pid" },
      { "type": "mount" },
      { "type": "uts" },
      { "type": "ipc" },
      { "type": "network" }
    ],
    "resources": {
      "memory": {
        "limit": 134217728
      },
      "cpu": {
        "quota": 50000,
        "period": 100000
      },
      "pids": {
        "limit": 64
      }
    }
  }
}
